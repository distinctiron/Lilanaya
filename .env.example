# Copy to .env (git-ignored) and fill in what you need. Compose reads it automatically.

# --- Plain-English strategy compile (optional; unset = switched off) ---
# Development and test: a Claude API key.
ANTHROPIC_API_KEY=
# Production: a model deployed in Azure OpenAI. The full address of the responses endpoint, and the key.
AZURE_OPENAI_URL=
# AZURE_OPENAI_URL=https://example-resource.openai.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_OPENAI_API_KEY=
# Only needed when both keys are set: anthropic | azure
LLM_PROVIDER=
# Model id. Claude API: default claude-opus-5-5. Azure: the deployment name (required, no default).
LLM_MODEL=
# Reasoning effort (low | medium | high). Claude: default medium. Azure: left out unless set; only reasoning models accept it.
LLM_EFFORT=

# --- Production-like stack only (compose.prod.yaml) ---
# POSTGRES_PASSWORD=
# PUBLIC_URL=https://lilanaya.example
# SMTP_URL=smtps://user:password@smtp.example:465
# MAIL_FROM=Lilanaya <no-reply@lilanaya.example>
