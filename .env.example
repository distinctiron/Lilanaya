# Copy to .env (git-ignored) and fill in what you need. Compose reads it automatically.

# --- Plain-English strategy compile (optional; unset = switched off) ---
# Development and test: a Claude API key.
ANTHROPIC_API_KEY=
# Production: Claude in Microsoft Foundry (Azure). Give the key and either the resource name or the full base URL.
ANTHROPIC_FOUNDRY_API_KEY=
ANTHROPIC_FOUNDRY_RESOURCE=
# ANTHROPIC_FOUNDRY_BASE_URL=https://example-resource.services.ai.azure.com/anthropic
# Only needed when both keys are set: anthropic | azure
LLM_PROVIDER=
# Model id; on Azure, the deployment name. Default: claude-opus-5-5
LLM_MODEL=

# --- Production-like stack only (compose.prod.yaml) ---
# POSTGRES_PASSWORD=
# PUBLIC_URL=https://lilanaya.example
# SMTP_URL=smtps://user:password@smtp.example:465
# MAIL_FROM=Lilanaya <no-reply@lilanaya.example>
