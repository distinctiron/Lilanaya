# Copy to .env (git-ignored) and fill in what you need. Compose reads it automatically.

# --- Plain-English strategy compile (optional; unset = switched off) ---
# An AI Gateway API key from the Vercel dashboard (AI Gateway, API keys). It pays for two things:
# the language model that writes the rules, and Jev, which screens every description first.
AI_GATEWAY_API_KEY=
# The gateway's id of the language model. Default anthropic/claude-opus-5.5.
LLM_MODEL=
# Reasoning effort (low | medium | high), or none to leave it out. Default medium.
LLM_EFFORT=
# The screening model. Default typesafe-ai/jev.
JEV_MODEL=
# How sure the screen must be that a text is a strategy description, 0 to 1. Default 0.5.
# Raise it to turn more away, lower it to let more through; measure on real descriptions before changing it.
JEV_MIN_CONFIDENCE=
# on (default): only providers that keep nothing of a request are used. off: the gateway's own settings decide.
AI_ZERO_DATA_RETENTION=

# --- Usage limits (all optional; the defaults are shown) ---
# Strategies the AI writes: each time the language model writes rules from a description, one is used up.
# A free user has this many per world, for good; a subscriber this many per paid month, across all worlds.
# (The settings keep their older names.)
# FREE_AI_REQUESTS_PER_WORLD=3
# SUBSCRIBER_AI_REQUESTS_PER_MONTH=20
# Runs a user may start per month, by plan: the calendar month when free, the paid month for a subscriber.
# FREE_MONTHLY_RUNS=100
# SUBSCRIBER_MONTHLY_RUNS=1000
# Runs one user may have waiting or running at once.
# MAX_ACTIVE_RUNS=2
# Strategy checks (previews and saves) per user per hour.
# PREVIEWS_PER_HOUR=120
# Plain-English compiles per user per hour (a brake on bursts; the plan's allowance above is the real limit).
# COMPILES_PER_HOUR=20
# Plain-English compiles, and the tokens they may use, for all users together per day (UTC).
# Reaching either switches compile off until the next day.
# COMPILES_PER_DAY=500
# COMPILE_TOKENS_PER_DAY=2000000

# --- Payment through Stripe (optional; without the secret key nothing is for sale) ---
# In Stripe: make one product with a monthly price (the subscription) and one product with a one-off price
# per pack (10 strategies + 100 runs, 20 + 200, 50 + 500). The amounts and the currency are set there, and
# the site shows them from there. Switch on the customer portal, and add a webhook endpoint at
#   {PUBLIC_URL}/api/billing/webhook
# for these events: checkout.session.completed, checkout.session.async_payment_succeeded,
# customer.subscription.created, customer.subscription.updated, customer.subscription.deleted,
# invoice.paid, invoice.payment_failed, charge.refunded, charge.dispute.created.
# Use test-mode keys (sk_test_…) until everything has been tried.
STRIPE_SECRET_KEY=
# The webhook endpoint's signing secret (whsec_…).
STRIPE_WEBHOOK_SECRET=
# The ids of the prices (price_…). A pack whose price is left empty is not offered.
STRIPE_SUBSCRIPTION_PRICE=
STRIPE_PACK_SMALL_PRICE=
STRIPE_PACK_MEDIUM_PRICE=
STRIPE_PACK_LARGE_PRICE=
# on (default): Stripe Tax adds VAT at checkout by the buyer's country (needs Stripe Tax set up, and the
# prices set to "exclusive of tax"). off: the price is charged as it is.
STRIPE_TAX=

# --- Sign-in through Google, Apple, Facebook, GitHub (each behind its own flag, all off by default) ---
# A flag is on | off; unset is off. A provider that is off is not offered, whatever is filled in for it.
# A provider that is on needs all of its lines filled, or the API refuses to start and says what is missing.
# Register this redirect address with each provider you switch on (PUBLIC_URL is http://localhost:3000 in development):
#   {PUBLIC_URL}/api/auth/google/callback   …/apple/callback   …/facebook/callback   …/github/callback

# Google: an OAuth client of type "Web application" (Google Cloud console, APIs & Services, Credentials).
GOOGLE_SIGN_IN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: a Services ID with "Sign in with Apple" (the client id), the team id, and a key (.p8) with its key id.
# The key: the file's text on one line with \n for line breaks, or just its base64 body.
# Apple does not accept localhost or plain http: it needs PUBLIC_URL to be an https address on a real domain.
APPLE_SIGN_IN=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Facebook: the app id and app secret of an app with "Facebook Login" (developers.facebook.com).
FACEBOOK_SIGN_IN=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# GitHub: an OAuth app (Settings, Developer settings, OAuth Apps).
GITHUB_SIGN_IN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Production-like stack only (compose.prod.yaml) ---
# POSTGRES_PASSWORD=
# PUBLIC_URL=https://lilanaya.example
# SMTP_URL=smtps://user:password@smtp.example:465
# MAIL_FROM=Lilanaya <no-reply@lilanaya.example>
