# The nginx image fills in ${API_HOSTPORT} and ${NGINX_LOCAL_RESOLVERS} from the environment
# when the container starts (see the Dockerfile). nginx's own $variables are left alone.

# Request limits per client address. A request over the limit is answered 429.
# Sign-in routes are strict: they send email and create accounts.
limit_req_zone $binary_remote_addr zone=auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=api:10m rate=20r/s;
limit_req_status 429;

server {
    listen 80;
    root /usr/share/nginx/html;
    server_tokens off;

    # The limits above must count the visitor's own address, which arrives in X-Forwarded-For.
    # Between the visitor and this server are the host's proxies: Render's private network and
    # Cloudflare (Render's own, and ours when the domain is proxied). Their addresses are
    # skipped; the last address in the header that is not one of theirs is the visitor's. A
    # visitor cannot fake it: whatever they put in the header, Cloudflare adds their real
    # address after it. Ranges: https://www.cloudflare.com/ips/
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    set_real_ip_from 100.64.0.0/10;
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Look the API up through the container's own DNS on each request (cached 10s) instead
    # of once at start-up, so the proxy keeps working when the API is restarted or moved.
    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

    # The API takes bodies up to 128 KB; refuse larger ones here.
    client_max_body_size 128k;

    # The site loads nothing from anywhere else and is never shown inside another page.
    # (add_header is not inherited by a block that has its own, hence the include.)
    include /etc/nginx/security-headers.conf;

    location /api/auth/ {
        limit_req zone=auth burst=10 nodelay;
        set $api http://${API_HOSTPORT};
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/ {
        # The results page asks for a run twice a second while it waits; this leaves room for that and more.
        limit_req zone=api burst=60 nodelay;
        set $api http://${API_HOSTPORT};
        proxy_pass $api;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # Always revalidate, so edits show up on refresh.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
